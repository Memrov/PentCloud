{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pentcloud-browser-fixture",
  "main": "ui-fixture-worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "STREAMS", "class_name": "StreamFixture" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StreamFixture"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../node_modules/.cache/pentcloud-browser-fixture",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
