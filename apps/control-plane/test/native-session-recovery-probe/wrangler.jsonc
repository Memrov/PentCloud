{
  "name": "native-question-recovery-local-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ATTEMPTS",
        "class_name": "QuestionRecovery"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QuestionRecovery"
      ]
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
