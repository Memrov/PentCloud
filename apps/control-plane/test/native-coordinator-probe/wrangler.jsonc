{
  "name": "native-coordinator-local-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "ProbeCoordinator"
      },
      {
        "name": "ATTEMPTS",
        "class_name": "FakeAttempt"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ProbeCoordinator",
        "FakeAttempt"
      ]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.tmpl",
        "**/*.tmpl?raw",
        "**/*.md?raw"
      ],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
