{
  "name": "pentcloud-native-research-canary",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_ctx_exports"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE",
        "class_name": "ResearchProbe"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ResearchProbe"
      ]
    }
  ]
}
