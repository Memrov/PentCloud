{
  "name": "native-opencode-server-local-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@modelcontextprotocol/server": "./node_modules/@modelcontextprotocol/server/dist/index.mjs",
    "@modelcontextprotocol/server/_shims": "./node_modules/@modelcontextprotocol/server/dist/shimsWorkerd.mjs"
  },
  "worker_loaders": [{"binding": "LOADER"}],
  "durable_objects": {"bindings": [
    {"name": "COORDINATOR", "class_name": "ServerCoordinator"},
    {"name": "ATTEMPTS", "class_name": "ServerAttempt"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ServerCoordinator", "ServerAttempt"]}],
  "rules": [{"type": "Text", "globs": ["**/*.tmpl", "**/*.tmpl?raw", "**/*.md?raw"], "fallthrough": true}],
  "workers_dev": false,
  "preview_urls": false
}
