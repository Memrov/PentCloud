{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "ESNext.Disposable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vitest/globals",
      "node",
      "@cloudflare/workers-types/experimental"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "vite.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "test/native-opencode-server-probe",
    "test/native-opencode-cloud-probe"
  ]
}
