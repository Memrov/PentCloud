{
  "name": "@pentagi-artifacts/control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && node ../../scripts/check-native-worker-build.mjs",
