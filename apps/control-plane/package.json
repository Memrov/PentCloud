    "@vitejs/plugin-react": "6.3.0",
    "eventsource-parser": "4.1.3",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
