    "@cloudflare/playwright": "1.3.6",
    "@cloudflare/puppeteer": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@opencode/plugin": "2.2.6",
    "@opencode/sdk": "2.2.6",
    "@phosphor-icons/react": "2.1.10",
    "@platformatic/vfs": "0.5.0",
    "agents": "0.33.0",
    "ai": "7.0.166",
    "jose": "6.2.17",
    "just-bash": "3.6.0",
