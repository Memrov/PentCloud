{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pentcloud-app",
  "main": "src/worker.ts",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_ctx_exports"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "issues": {
      "enabled": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator"
      },
      {
        "name": "ATTEMPTS",
        "class_name": "NativeAttempt"
      },
      {
        "name": "MODEL_TESTS",
        "class_name": "OpenCodeConnectionTest"
      }
    ],
    "code_update_strategy": {
      "mode": "deferred",
      "max_delay": 300
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ProofQueue",
        "ProofAttempt"
      ]
    },
    {
      "tag": "v2-pentcloud-native",
      "new_sqlite_classes": [
        "Coordinator",
        "NativeAttempt"
      ]
    },
    {
      "tag": "v3-native-model-tests",
      "new_sqlite_classes": [
        "OpenCodeConnectionTest"
      ]
    }
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "pentcloud-local"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "services": [
    {
      "binding": "TOOLBOX",
      "service": "pentcloud-toolbox",
      "entrypoint": "ToolboxGateway"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": { "events": [] },
  "vars": {
    "CONTROL_BASE_URL": "https://configure-pentcloud.invalid",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ARTIFACTS_NAMESPACE": "pentcloud-local",
    "AI_GATEWAY_ID": ""
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
