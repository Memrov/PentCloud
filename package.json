{
  "name": "pentagi-artifacts",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "infra/aws-toolbox/control",
    "infra/tool-packs"
  ],
  "scripts": {
    "test": "vp test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "bash scripts/native-cloudflare-verify.sh",
    "test:unit": "vp test --project unit",
    "test:workers": "vp test --config apps/control-plane/vite.workers.config.ts",
    "test:watch": "vp test watch --project unit",
    "test:workers:watch": "vp test watch --config apps/control-plane/vite.workers.config.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "qa:ui": "node scripts/browser-run-qa.mjs",
    "qa:ui:interactive": "node scripts/browser-run-interactive-qa.mjs",
    "test:gateway": "npm test --workspace @pentagi-artifacts/aws-toolbox-control",
    "test:integration": "node apps/control-plane/test/native-coordinator-probe/state.mjs && node scripts/test-native-attempt-runtime.mjs",
    "check": "bash scripts/native-cloudflare-verify.sh --check",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint",
    "verify:gateway": "bash scripts/native-cloudflare-verify.sh --worker gateway",
    "verify:full": "bash scripts/native-cloudflare-verify.sh --full --worker all",
    "build": "node scripts/build-customer.mjs",
    "deploy": "wrangler deploy --config apps/control-plane/dist-customer/worker/wrangler.json",
    "test:customer": "vp test --config apps/control-plane/vite.customer.config.ts",
    "prepare": "vp config"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "overrides": {
    "wrangler": "4.158.0",
    "undici@>=7 <8": "7.30.1",
    "sharp@<0.35.5": "0.35.5",
    "katex@<0.18.2": "0.18.2",
    "glob@>=9 <14.0.2": "14.0.2",
    "minimatch@>=7 <11.0.1": "11.0.1",
    "zod@<4.6.6": "4.6.7",
    "@puppeteer/browsers": "3.2.6",
    "@memrov2/pentcloud-tool-runtime": "0.1.1-dev.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  },
  "devDependencies": {
    "@cloudflare/playwright": "1.3.6",
    "@cloudflare/workers-types": "5.20261109.1",
    "miniflare": "5.20261012.1-beta",
    "vite-plus": "1.5.1"
  },
  "packageManager": "npm@11.19.0"
}
