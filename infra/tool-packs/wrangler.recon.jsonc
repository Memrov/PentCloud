{
  "name": "pentcloud-tool-recon",
  "main": "src/packs/recon.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER",
        "class_name": "ReconRunner"
      }
    ]
  },
  "exports": {
    "ReconRunner": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "containers": [
    {
      "class_name": "ReconRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "recon": {
          "dockerfile": "Dockerfile",
          "build_context": "../../.pentcloud-tools",
          "build_vars": {
            "PACK": "recon",
            "RUNTIME_IMAGE": "alpine:3.22.2@sha256:85f2b723e106c34644cd5851d7e81ee87da98ac54672b29947c052a45d31dc2f"
          }
        }
      }
    }
  ]
}
