{
  "name": "pentcloud-tool-packs",
  "main": "src/legacy-worker.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RECON",
        "class_name": "ReconRunner"
      },
      {
        "name": "HTTP",
        "class_name": "HttpRunner"
      },
      {
        "name": "NUCLEI",
        "class_name": "NucleiRunner"
      },
      {
        "name": "SQLMAP",
        "class_name": "SqlmapRunner"
      },
      {
        "name": "SERVICE",
        "class_name": "ServiceRunner"
      },
      {
        "name": "WEB_CONTEXT",
        "class_name": "WebContextRunner"
      },
      {
        "name": "PCAP",
        "class_name": "PcapRunner"
      },
      {
        "name": "FILE_ANALYSIS",
        "class_name": "FileRunner"
      },
      {
        "name": "PASSWORD",
        "class_name": "PasswordRunner"
      },
      {
        "name": "REFERENCE",
        "class_name": "ReferenceRunner"
      },
      {
        "name": "METASPLOIT",
        "class_name": "MetasploitRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReconRunner",
        "HttpRunner",
        "NucleiRunner",
        "SqlmapRunner",
        "ServiceRunner",
        "WebContextRunner",
        "PcapRunner",
        "FileRunner",
        "PasswordRunner",
        "ReferenceRunner",
        "MetasploitRunner"
      ]
    }
  ]
}
