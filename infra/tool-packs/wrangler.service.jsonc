{
  "name": "pentcloud-tool-service",
  "main": "src/packs/service.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER",
        "class_name": "ServiceRunner"
      }
    ]
  },
  "exports": {
    "ServiceRunner": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "containers": [
    {
      "class_name": "ServiceRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "service": {
          "dockerfile": "Dockerfile",
          "build_context": "../../.pentcloud-tools",
          "build_vars": {
            "PACK": "service",
            "RUNTIME_IMAGE": "docker.io/library/debian@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2"
          }
        }
      }
    }
  ]
}
