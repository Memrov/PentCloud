{
  "name": "pentcloud-dev-tool-reference",
  "main": "src/packs/reference.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER",
        "class_name": "ReferenceRunner"
      }
    ]
  },
  "containers": [
    {
      "class_name": "ReferenceRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "reference": {
          "dockerfile": "Dockerfile",
          "build_context": "../../.pentcloud-tools",
          "build_vars": {
            "PACK": "reference",
            "RUNTIME_IMAGE": "docker.io/library/debian@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2"
          }
        }
      },
      "name": "pentcloud-dev-tools-reference"
    }
  ],
  "exports": {
    "ReferenceRunner": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "pentcloud-dev-tools-reference"
    }
  }
}
