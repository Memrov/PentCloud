{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pentcloud",
  "main": "apps/control-plane/src/customer/worker.ts",
  "minify": true,
  "upload_source_maps": false,
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_ctx_exports"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "issues": {
      "enabled": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/control-plane/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator"
      },
      {
        "name": "ATTEMPTS",
        "class_name": "NativeAttempt"
      },
      {
        "name": "MODEL_TESTS",
        "class_name": "OpenCodeConnectionTest"
      },
      {
        "name": "RECON",
        "class_name": "ReconRunner"
      },
      {
        "name": "HTTP",
        "class_name": "HttpRunner"
      },
      {
        "name": "NUCLEI",
        "class_name": "NucleiRunner"
      },
      {
        "name": "SQLMAP",
        "class_name": "SqlmapRunner"
      },
      {
        "name": "SERVICE",
        "class_name": "ServiceRunner"
      },
      {
        "name": "WEB_CONTEXT",
        "class_name": "WebContextRunner"
      },
      {
        "name": "PCAP",
        "class_name": "PcapRunner"
      },
      {
        "name": "FILE_ANALYSIS",
        "class_name": "FileRunner"
      },
      {
        "name": "PASSWORD",
        "class_name": "PasswordRunner"
      },
      {
        "name": "REFERENCE",
        "class_name": "ReferenceRunner"
      },
      {
        "name": "METASPLOIT",
        "class_name": "MetasploitRunner"
      }
    ],
    "code_update_strategy": {
      "mode": "deferred",
      "max_delay": 300
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ProofQueue",
        "ProofAttempt"
      ]
    },
    {
      "tag": "v2-pentcloud-native",
      "new_sqlite_classes": [
        "Coordinator",
        "NativeAttempt"
      ]
    },
    {
      "tag": "v3-native-model-tests",
      "new_sqlite_classes": [
        "OpenCodeConnectionTest"
      ]
    },
    {
      "tag": "v4-tool-packs",
      "new_sqlite_classes": [
        "ReconRunner",
        "HttpRunner",
        "NucleiRunner",
        "SqlmapRunner",
        "ServiceRunner",
        "WebContextRunner",
        "PcapRunner",
        "FileRunner",
        "PasswordRunner",
        "ReferenceRunner",
        "MetasploitRunner"
      ]
    }
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "pentcloud"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "binding": "RESULTS",
      "name": "pentcloud",
      "class_name": "ResultValidation"
    }
  ],
  "vars": {},
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.tmpl",
        "**/*.tmpl?raw",
        "**/*.md?raw",
        "**/*.md"
      ],
      "fallthrough": true
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "dependencies_instrumentation": {
    "enabled": false
  },
  "containers": [
    {
      "class_name": "ReconRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "recon": {
          "dockerfile": ".pentcloud-tools/images/recon/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "HttpRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "http": {
          "dockerfile": ".pentcloud-tools/images/http/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "NucleiRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "nuclei": {
          "dockerfile": ".pentcloud-tools/images/nuclei/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "SqlmapRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "sqlmap": {
          "dockerfile": ".pentcloud-tools/images/sqlmap/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "ServiceRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "service": {
          "dockerfile": ".pentcloud-tools/images/service/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "WebContextRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "web-context": {
          "dockerfile": ".pentcloud-tools/images/web-context/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "PcapRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "pcap": {
          "dockerfile": ".pentcloud-tools/images/pcap/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "FileRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "file-analysis": {
          "dockerfile": ".pentcloud-tools/images/file-analysis/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "PasswordRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "password": {
          "dockerfile": ".pentcloud-tools/images/password/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "ReferenceRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "reference": {
          "dockerfile": ".pentcloud-tools/images/reference/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    },
    {
      "class_name": "MetasploitRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "metasploit": {
          "dockerfile": ".pentcloud-tools/images/metasploit/Dockerfile",
          "build_context": ".pentcloud-tools"
        }
      }
    }
  ]
}
