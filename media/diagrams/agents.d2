...@_style
direction: down
coordinator: "Coordinator + native Lifecycle\nLive runs, admission and acceptance" {class: card}
sessions: {
  label: "Separate OpenCode sessions and workspaces"
  class: group
  grid-columns: 2
  primary: "Primary\nPlan and coordinate" {class: card}
  searcher: "Searcher\nResearch and discovery" {class: card}
  pentester: "Pentester\nTest and capture evidence" {class: card}
  reporter: "Reporter\nReview recorded work" {class: card}
}
git: "Artifacts Git\nAccepted work and captured evidence" {class: card}
tools: "Installed tool capabilities\nTool packs · Browser Run · Computer" {class: card}
coordinator -> sessions: "admit and track"
sessions -> git: "read accepted work / submit candidates"
sessions -> tools: "role-dependent access"
limits: "One mutating attempt active; at most two waiting.\nTool packs belong to each attempt and pack.\nLegacy installations retain shared Kali." {class: note}
tools -> limits: {style.opacity: 0}
