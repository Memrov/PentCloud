# Shared typography and geometry. Theme colors are supplied by the renderer.
vars: {
  d2-config: {layout-engine: elk}
}
classes: {
  card: {
    style: {border-radius: 12; stroke-width: 1; font-size: 20; bold: false}
  }
  group: {
    style: {border-radius: 16; stroke-width: 1; font-size: 20; bold: false}
  }
  note: {
    shape: text
    style: {font-size: 18; bold: false}
  }
}
