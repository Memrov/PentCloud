...@_style
direction: down
save: "Save a website or API\nReuse the target for another run" {class: card}
verify: "Confirm authorization and verify address\nStart model-free discovery" {class: card}
setup: "Choose models and attach context\nContinue setup during discovery" {class: card}
prepare: "Open the primary conversation\nRead-only preparation while discovery runs" {class: card}
investigate: "Follow specialist conversations\nSteer the admitted assessment" {class: card}
review: "Review findings and evidence\nRead or download the assessment" {class: card}
save -> verify -> setup -> prepare -> investigate -> review
