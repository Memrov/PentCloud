...@_style
direction: down
plan: "Check account access and costs\nWorkers Paid, Containers and Access" {class: card}
install: "Deploy to Cloudflare\nBuild the app and eleven tool images" {class: card}
protect: "Open /setup and protect the hostname\nOwner email policy through Cloudflare Access" {class: card}
workspace: "Prepare workspace\nInitialize the native Artifacts connection" {class: card}
models: "Connect OpenCode\nSave a Worker Secret and check availability" {class: card}
open: "Open the protected application\nSave your first target" {class: card}
plan -> install -> protect -> workspace -> models -> open
note: "Setup runs in the browser in your Cloudflare account.\nModel tests and assessments are separate actions." {class: note}
open -> note: {style.opacity: 0}
